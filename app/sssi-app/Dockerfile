FROM node:22-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_API_BASE_URL=""
ARG VITE_API_TIMEOUT=30000
ARG VITE_AUTH_BEARER_TOKEN_KEY=auth_token
ARG VITE_AUTH_REFRESH_TOKEN_KEY=refresh_token
ARG VITE_TURNSTILE_SITE_KEY
ARG VITE_APP_BRAND_NAME=PROSEG
ARG VITE_APP_BRAND_FULL_NAME="Programa de Servicios Generales"
ARG VITE_ENABLE_AUTH=true
ARG VITE_ENABLE_INVENTORY=true
ARG VITE_ENABLE_SECURITY=true
ARG VITE_DEBUG_MODE=false
ARG VITE_LOG_LEVEL=info

RUN printf '%s\n' \
      "VITE_API_BASE_URL=${VITE_API_BASE_URL}" \
      "VITE_API_TIMEOUT=${VITE_API_TIMEOUT}" \
      "VITE_AUTH_BEARER_TOKEN_KEY=${VITE_AUTH_BEARER_TOKEN_KEY}" \
      "VITE_AUTH_REFRESH_TOKEN_KEY=${VITE_AUTH_REFRESH_TOKEN_KEY}" \
      "VITE_TURNSTILE_SITE_KEY=${VITE_TURNSTILE_SITE_KEY}" \
      "VITE_APP_BRAND_NAME=${VITE_APP_BRAND_NAME}" \
      "VITE_APP_BRAND_FULL_NAME=${VITE_APP_BRAND_FULL_NAME}" \
      "VITE_ENABLE_AUTH=${VITE_ENABLE_AUTH}" \
      "VITE_ENABLE_INVENTORY=${VITE_ENABLE_INVENTORY}" \
      "VITE_ENABLE_SECURITY=${VITE_ENABLE_SECURITY}" \
      "VITE_DEBUG_MODE=${VITE_DEBUG_MODE}" \
      "VITE_LOG_LEVEL=${VITE_LOG_LEVEL}" \
    > .env.production \
 && npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
